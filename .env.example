# Persu API — copy to `.env.local` and adjust values.
# Loaded by Next.js at the project root; only NEXT_PUBLIC_* reach the browser.

# Backend base URL. Leave empty to make same-origin (relative) requests.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Backend is not ready yet: API calls are served by in-app mocks.
# Set to `false` once the real API is live (see src/constants/api.constant.ts).
NEXT_PUBLIC_API_USE_MOCK=true
